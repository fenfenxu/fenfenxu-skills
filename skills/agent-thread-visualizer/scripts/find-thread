#!/usr/bin/env python3
"""Deprecated entrypoint — use find-thread-by-id or find-thread-by-name.

Do not auto-detect UUID vs name here; the LLM chooses the script.
"""

from __future__ import annotations

import sys

MSG = """\
find-thread is split — pick one (do not guess UUID vs name in a single script):

  python3 scripts/find-thread-by-id   <uuid-or-fragment>   # session ID / path
  python3 scripts/find-thread-by-name [keywords]           # title / first user msg
  python3 scripts/find-thread-by-name                      # recent for cwd

Shared flags: -a HOST --all -n N --json --deep (name only) --include-subagents
"""

if __name__ == "__main__":
    print(MSG, file=sys.stderr)
