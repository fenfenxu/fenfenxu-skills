#!/usr/bin/env python3
"""Locate agent threads by UI title / first-user keywords (or list recent).

The caller (LLM) decides this is a name lookup — no UUID path matching.
Omit query to list recent parent threads for the workspace.

Title sources (preferred over first-user prompt):
  cursor    composer.composerHeaders in Cursor state.vscdb
  codex     threads.title in ~/.codex/state_*.sqlite (+ session_index)
  workbuddy sessions.title/custom_title in ~/.workbuddy/workbuddy.db
  claude    latest type=ai-title aiTitle in session jsonl
  kimi      state.json title under each session dir
"""

from __future__ import annotations

import sys
from pathlib import Path

_SCRIPTS = Path(__file__).resolve().parent
if str(_SCRIPTS) not in sys.path:
    sys.path.insert(0, str(_SCRIPTS))

from _find_thread_common import run_cli  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(run_cli("name"))
